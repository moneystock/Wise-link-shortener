# Variables de Entorno para WiseLinks
PORT=3000
NODE_ENV=production

# Define tu URL pública (sin barra final al final).
# Al definirla, todos los enlaces y QR generados usarán este subdominio:
BASE_URL=https://go.wisemarketing.agency

# Directorio de persistencia para SQLite (en producción se monta en /data)
DB_DIR=/data
# O ruta absoluta específica:
# DB_PATH=/data/database.sqlite
